# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.onbellek/

# Çalışma zamanı verisi: yüklenen raporlar, hakem puanları, aktarılmış
# yarışmalar. Kaynak değil, durum — ve yüklenen raporlar gerçek yarışmacı
# belgesi olabilir; depoya girmemeli.
veri/
# Katalog istisna: teknofest.org taramasının sonucu. Sürümlenmesi işe yarar,
# yoksa her dağıtımda 60 sayfa yeniden çekilmek zorunda kalır.
!veri/katalog.json
.dev.log
# SQLite çalışma dosyaları — WAL ve shared-memory
veri/*.db-wal
veri/*.db-shm
