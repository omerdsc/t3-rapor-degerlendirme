# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Örnek dosyalar istisna: yalnızca yer tutucu taşıyorlar ve kurulum
# adımı (`cp .env.ornek .env.local`) onlarsız çalışmıyor.
!.env.ornek
!.env.sunucu.ornek

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.onbellek/

# Çalışma zamanı verisi: yüklenen raporlar, hakem puanları, veritabanı.
# Kaynak değil, durum — ve yüklenen raporlar gerçek yarışmacı belgesi
# olabilir; depoya girmemeli.
#
# `veri/` yerine `veri/*`: dizinin kendisi dışlanırsa git içine hiç inmez
# ve aşağıdaki istisnalar sessizce çalışmaz.
veri/*
# İstisnalar — hepsi teknofest.org'un açık verisinden üretiliyor, kişisel
# veri taşımıyor. Depoda durmaları klonlayanın sistemi kurabilmesi için
# şart: yoksa 60 sayfa yeniden taranmak ve 43 şablon yeniden çözümlenmek
# zorunda kalır.
!veri/katalog.json
!veri/katalog-dogrulama.json
!veri/terim-profilleri.json
!veri/yarismalar/
.dev.log

# Dağıtım için hazırlanan temiz veri kümesi — üretiliyor, kaynak değil.
# Sentetik rapor taşıyor ama yine de depoya girmesin: `npm run dagitim:veri`
# ile her an yeniden üretilebiliyor.
dagitim/

# `test-verisi/` bilerek burada DEĞİL. İçindeki PDF'ler sentetik ve
# sürümlenmiş: analiz betikleri ve kanıt toplama onlara dayanıyor, klonun
# ilk anda çalışması için depoda durmaları gerekiyor.
