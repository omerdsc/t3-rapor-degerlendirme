# Bu dosyayı `.env.local` adıyla kopyalayıp içini doldurun.
#   cp .env.ornek .env.local
#
# .env.local git'e GİRMEZ (.gitignore'da `.env*` var). Anahtarı asla
# sohbete, ekran görüntüsüne veya depoya yapıştırmayın.

# console.anthropic.com → Settings → API Keys → Create Key
ANTHROPIC_API_KEY=buraya-anahtari-yapistir

# Crossref ve OpenAlex "polite pool" için iletişim adresi.
# Zorunlu değil ama daha yüksek hız sınırı verirler.
DOGRULAMA_ILETISIM=ekip-adresiniz@ornek.com

# Rapor başına harcama tavanı (USD). Aşılırsa sistem çağrı yapmayı reddeder.
RAPOR_BASINA_TAVAN=1.00

# Toplam harcama tavanı (USD). Bütçe koruması.
TOPLAM_TAVAN=50.00

# ── KOORDİNASYON ERİŞİMİ ─────────────────────────────────────────────────
# Koordinasyon panelinin ortak parolası. TANIMLI DEĞİLSE PANEL HERKESE
# AÇIK — o durumda her koordinasyon ekranında uyarı şeridi görünür.
#
# Bu bir kullanıcı hesabı değil, ekibin ortak anahtarı. Kurumsal kurulumda
# yerini kurum kimlik doğrulaması (SSO) alır; değişecek tek yer
# `src/lib/yetki/koordinasyon.ts`.
#
# Uzun tutun: hız sınırlama yok, kaba kuvvete karşı tek koruma uzunluk.
# Hakem ve yarışmacı portalları bu anahtarı İSTEMEZ — hakem kendi
# erişim koduyla, yarışmacı başvuru numarasıyla girer.
KOORDINASYON_ANAHTARI=

# Canlı (https) kurulumda çereze `Secure` eklenmeli:
# src/app/api/koordinasyon-giris/route.ts içindeki set-cookie satırı.

# ── EKRANDA MALİYET ──────────────────────────────────────────────────────
# Koordinasyon panelinde para tutarları görünsün mü? Varsayılan KAPALI.
#   MALIYET_GOSTER=acik   → tutarlar görünür
#
# Kapalıyken rakam istemciye HİÇ GÖNDERİLMİYOR (sayfa kaynağında duran bir
# rakam gizlenmiş sayılmaz). Ama iki şey gizlenmiyor: adımın ücretli
# olduğu ve bütçe tavanı aşılacaksa işlemin yarıda duracağı — ikisi de
# fiyat değil davranış bilgisi.
MALIYET_GOSTER=
