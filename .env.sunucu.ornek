# SUNUCU ORTAM DEĞİŞKENLERİ
#
# Bu dosyayı sunucuda `.env.sunucu` adıyla kopyalayıp doldurun.
# `.gitignore` içindeki `.env*` kuralı bu dosyayı depoya girmekten
# koruyor — anahtarları asla depoya, sohbete veya ekran görüntüsüne
# yapıştırmayın.
#
#   cp .env.sunucu.ornek .env.sunucu
#   nano .env.sunucu

# ── ZORUNLU ──────────────────────────────────────────────────────────────

# Sitenin alan adı. Caddy sertifikayı bu ad için alıyor.
# Ücretsiz alan adı: duckdns.org  (örn. tprds.duckdns.org)
TPRDS_ALAN_ADI=tprds.duckdns.org

# Koordinasyon panelinin ortak parolası.
#
# ÜRETİMDE ZORUNLU: tanımlı değilse uygulama açılmıyor (her isteğe 500
# dönüyor). Sebep basit — anahtarsız panele erişen herkes bütün veriyi
# dışa aktarabilir ve ücretli yapay zekâ çağrısı başlatabilir.
#
# Hız sınırlama YOK; kaba kuvvete karşı tek koruma uzunluk. En az 24
# karakter. Üretmek için:  openssl rand -base64 32
KOORDINASYON_ANAHTARI=

# ── YAPAY ZEKÂ (isteğe bağlı) ────────────────────────────────────────────
#
# Boş bırakılırsa sistem çalışır ama yapay zekâ değerlendirmesi (MVP 6)
# ve şartname özeti kapalı olur. Deterministik kontrollerin hepsi
# (şablon uyumu, kaynak doğrulama, kopya tespiti) anahtarsız çalışıyor.
ANTHROPIC_API_KEY=

# Harcama tavanları (USD). Aşılırsa sistem çağrıyı REDDEDİYOR.
# Açık bir adreste bu tavanlar tek para korumanız — düşük tutun.
RAPOR_BASINA_TAVAN=0.60
TOPLAM_TAVAN=8.00

# ── İSTEĞE BAĞLI ─────────────────────────────────────────────────────────

# Crossref ve OpenAlex "polite pool" iletişim adresi — daha yüksek hız
# sınırı verirler. Dışarıya yalnızca kaynak BAŞLIKLARI gidiyor.
DOGRULAMA_ILETISIM=

# Koordinasyon panelinde para tutarları görünsün mü.  acik | (boş)
MALIYET_GOSTER=

# Kaynak doğrulama kapatılabilir (yükleme hızlanır, bulgu kaybolur).
# KAYNAK_DOGRULA=kapali

# Paneli BİLEREK herkese açık çalıştırmak için. Anahtar zorunluluğunu
# kaldırır. Açık bir adreste kullanmayın.
# KOORDINASYON_ACIK=evet
